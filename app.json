{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Shared dependency-update settings for Altric application repositories."
  ],
  "extends": [
    "github>altrichq/.github"
  ],
  "enabledManagers": [
    "npm",
    "nvm",
    "github-actions",
    "dockerfile",
    "docker-compose"
  ],
  "npm": {
    "minimumReleaseAge": "3 days"
  },
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^@types\\//"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "low-risk updates",
      "groupSlug": "low-risk",
      "automerge": true
    },
    {
      "matchPackageNames": [
        "tailwindcss",
        "/^@tailwindcss\\//",
        "postcss",
        "autoprefixer"
      ],
      "groupName": null,
      "labels": [
        "dependencies",
        "design"
      ],
      "automerge": true
    }
  ]
}
