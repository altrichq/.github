{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Shared dependency-update settings for Altric repositories."
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":rebaseStalePrs"
  ],
  "timezone": "Africa/Lagos",
  "schedule": [
    "after 2:00am and before 4:00am"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency dashboard",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "branchConcurrentLimit": 6,
  "labels": [
    "dependencies",
    "maintenance"
  ],
  "separateMajorMinor": true,
  "separateMultipleMajor": false,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 2-4 * * 1"
    ],
    "automerge": false,
    "commitMessageAction": "Refresh",
    "labels": [
      "dependencies",
      "maintenance"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "automerge": false,
    "minimumReleaseAge": null,
    "labels": [
      "dependencies",
      "security"
    ],
    "addLabels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "major"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "groupName": "low-risk updates",
      "groupSlug": "low-risk",
      "automerge": false
    },
    {
      "matchCurrentVersion": "/^0/",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": null,
      "labels": [
        "dependencies",
        "maintenance"
      ],
      "automerge": false
    },
    {
      "groupName": null,
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "/^@nestjs\\//",
        "/^@next\\//",
        "typescript",
        "node",
        "/^@types\\/node$/"
      ],
      "labels": [
        "dependencies",
        "runtime"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": null,
      "matchPackageNames": [
        "prisma",
        "/^@prisma\\//",
        "pg",
        "/^pg-/",
        "postgres",
        "postgresql",
        "/^@neondatabase\\//",
        "ioredis",
        "redis",
        "/^@redis\\//",
        "bullmq"
      ],
      "labels": [
        "dependencies",
        "database"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": null,
      "matchPackageNames": [
        "/^@temporalio\\//",
        "/^temporalio\\//",
        "temporalio/auto-setup",
        "temporalio/ui-server"
      ],
      "labels": [
        "dependencies",
        "workflow"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": null,
      "matchPackageNames": [
        "better-auth",
        "/^@better-auth\\//",
        "/^next-auth$/",
        "/^@auth\\//",
        "jsonwebtoken",
        "jose",
        "/^@node-saml\\//",
        "passport",
        "/^passport-/",
        "bcrypt",
        "bcryptjs",
        "argon2",
        "openid-client",
        "oauth4webapi",
        "/^@octokit\\//",
        "helmet",
        "cookie",
        "csrf",
        "/^@fastify\\/(cookie|session|csrf-protection)$/"
      ],
      "labels": [
        "dependencies",
        "security",
        "auth"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": null,
      "matchPackageNames": [
        "dayjs",
        "date-fns",
        "/^date-fns-/",
        "luxon",
        "/^@types\\/luxon$/",
        "moment",
        "moment-timezone",
        "/^@js-joda\\//",
        "rrule",
        "ical",
        "ical.js",
        "ical-generator",
        "node-ical",
        "tzdata",
        "/^@date-fns\\//",
        "temporal-polyfill",
        "cron",
        "cron-parser",
        "node-cron",
        "croner"
      ],
      "labels": [
        "dependencies",
        "time"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": null,
      "matchPackageNames": [
        "googleapis",
        "/^@google-cloud\\//",
        "/^@googleapis\\//",
        "google-auth-library",
        "/^@microsoft\\/microsoft-graph-client$/",
        "/^@microsoft\\/microsoft-graph-types/",
        "/^@azure\\/msal-/",
        "/^@azure\\/identity$/"
      ],
      "labels": [
        "dependencies",
        "providers"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": null,
      "matchPackageNames": [
        "stripe",
        "/^@stripe\\//",
        "paystack",
        "/^paystack-/",
        "/^@paystack\\//",
        "flutterwave-node-v3",
        "/^@lago-/",
        "lago-javascript-client"
      ],
      "labels": [
        "dependencies",
        "payments"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": null,
      "matchPackageNames": [
        "/^twitter-api/",
        "/^@atproto\\//",
        "/^linkedin/",
        "/^instagram/",
        "/^facebook-nodejs/",
        "/^@slack\\//",
        "/^discord\\.js$/",
        "/^@discordjs\\//",
        "mastodon-api",
        "/^tiktok/",
        "/^@mastra\\//"
      ],
      "labels": [
        "dependencies",
        "providers"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "kubernetes",
        "helmv3",
        "flux"
      ],
      "groupName": null,
      "labels": [
        "dependencies",
        "infrastructure"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "labels": [
        "dependencies",
        "ci"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "/^useblacksmith\\//"
      ],
      "groupName": null,
      "labels": [
        "dependencies",
        "ci"
      ],
      "automerge": false
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__fixtures__/**",
    "**/test/fixtures/**"
  ],
  "prBodyNotes": [
    "---",
    "**This PR does not merge itself.** Renovate has no automerge anywhere in the Altric organization, and no release branch accepts a bot merge. A green CI result here means the change builds, not that it ships.",
    "Release branches (`altric` in altrichq/altric, `main` in altrichq/homepage) are merged by a human, deliberately."
  ]
}
