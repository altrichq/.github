{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Shared dependency-update settings for Altric infrastructure repositories."
  ],
  "extends": [
    "github>altrichq/.github"
  ],
  "enabledManagers": [
    "kubernetes",
    "helmv3",
    "flux",
    "github-actions",
    "dockerfile"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/clusters/.+\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/clusters/.+\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "clusters/**/flux-system/**",
    "clusters/altric/app.yaml",
    "clusters/altric/homepage/homepage.yaml",
    "clusters/altric/image-automation.yaml"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "kubernetes",
        "docker-compose",
        "dockerfile"
      ],
      "groupName": null,
      "labels": [
        "dependencies",
        "infrastructure"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "postgres",
        "redis",
        "/postgres-partman/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "infrastructure",
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "helmv3",
        "flux"
      ],
      "groupName": null,
      "labels": [
        "dependencies",
        "infrastructure"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    }
  ]
}
